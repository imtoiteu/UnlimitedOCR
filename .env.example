# ──────────────────────────────────────────────────────────────────────────────
# Unlimited-OCR  —  Environment Variables
# Copy this file to .env and fill in your values.
# .env is excluded from git (see .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# HuggingFace model ID or absolute path to a locally downloaded copy.
# Leave as the HF ID to auto-download on first run (~7–14 GB).
MODEL_DIR=baidu/Unlimited-OCR

# Port for the Gradio web UI.
PORT=7860

# Directory where OCR results (.md files) are saved.
OUTPUT_DIR=./outputs

# CUDA device index (ignored on CPU / MPS machines).
CUDA_DEVICE=0

# HuggingFace access token — required only if the model is gated.
# Generate one at https://huggingface.co/settings/tokens
HF_TOKEN=
